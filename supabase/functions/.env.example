# Секреты Edge Functions для локальной разработки: скопируйте в supabase/functions/.env (этот файл в git не попадает).
# На сервере те же имена задаются командой `supabase secrets set ИМЯ=значение`.

# Итоги по записи совещания (функция summarize-meeting)
# Расшифровка речи — любой сервис, совместимый с OpenAI /audio/transcriptions
STT_API_KEY=
# OpenAI: https://api.openai.com/v1 + whisper-1;  Groq: https://api.groq.com/openai/v1 + whisper-large-v3
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
# Язык речи (ru, ka, en…); пусто — определять автоматически
STT_LANGUAGE=ru
# Итоги пишет Claude
ANTHROPIC_API_KEY=
# MEETING_SUMMARY_MODEL=claude-sonnet-5-5
# Запасной вариант, если на счёте Anthropic нет средств: итоги пишет модель через OpenAI-совместимый чат (например, Groq).
# Ключ и адрес по умолчанию те же, что у расшифровки; качество на русском ниже, чем у Claude.
# MEETING_SUMMARY_PROVIDER=openai
# SUMMARY_MODEL=openai/gpt-oss-120b
